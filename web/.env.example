# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (server-side only)
GOOGLE_API_KEY=your-google-api-key

# Cron protection (for /api/keepalive and /api/weather)
CRON_SECRET=your-cron-secret

# Upstash Redis — REQUIRED in production for rate limiting on /api/chat,
# /api/guest-data, /api/guest-token, and /api/nl-filter. Auto-injected by
# Vercel when you link an Upstash Redis database in the project's Storage tab.
# Not required locally (limiter becomes a no-op when unset in dev).
# KV_REST_API_URL=https://your-upstash-url.upstash.io
# KV_REST_API_TOKEN=your-upstash-token

# Email monitoring alerts (Resend)
RESEND_API_KEY=your-resend-api-key
ALERT_EMAIL_TO=you@example.com
# Optional: comma-separated
# ALERT_EMAIL_TO=you@example.com,teammate@example.com
# Optional sender; requires verified domain in Resend for production
# ALERT_EMAIL_FROM=IoT Monitor <alerts@yourdomain.com>

# Monitoring behavior
MONITORED_DEVICE_IDS=node1,node2
ALERT_STALE_MINUTES=10
ENABLE_RECOVERY_ALERTS=true
# Optional dashboard link included in email body
# ALERT_DASHBOARD_URL=https://your-app.vercel.app

# PostHog analytics (posthog.com - free tier: 1M events/month)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-api-key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# WeatherAPI.com
WEATHER_API_KEY=           # WeatherAPI.com API key (weatherapi.com/signup)

# Guest read-only access (generate a random token, share link: yoursite.com/view?token=VALUE)
# GUEST_VIEW_TOKEN=your-random-token-here

# Dashboard shared login (for local reference only - create user in Supabase Auth dashboard)
# DASHBOARD_SHARED_EMAIL=your-shared-email
# DASHBOARD_SHARED_PASSWORD=your-shared-password
