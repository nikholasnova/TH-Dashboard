# Env vars for the pen-test clone deploy (Vercel).
# Copy each row as a separate variable in your clone Vercel project's Settings → Environment Variables.
# Do NOT commit this file with real values filled in.

# --- From the clone Supabase project → Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-clone-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clone-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<clone-service-role-key>

# --- Clone-only secrets (Claude generated these in chat — paste here or regenerate) ---
GUEST_VIEW_TOKEN=<paste-from-chat-or-run-openssl-rand-hex-32>
CRON_SECRET=<paste-from-chat-or-run-openssl-rand-hex-32>

# --- Safe to reuse prod values (separate usage accounting per endpoint) ---
GOOGLE_API_KEY=<same as prod>
WEATHER_API_KEY=<same as prod>

# --- Set AFTER first deploy to the Vercel URL ---
NEXT_PUBLIC_SITE_URL=https://th-dashboard-clone.vercel.app

# --- Intentionally left unset on the clone ---
# RESEND_API_KEY=       → omit: alerts won't send, won't crash
# ALERT_EMAIL_TO=       → omit: no spam to real inbox
# NEXT_PUBLIC_POSTHOG_KEY=  → omit: no analytics pollution
# NEXT_PUBLIC_POSTHOG_HOST= → omit
# MONITORED_DEVICE_IDS= → omit: keepalive reads devices table fallback
